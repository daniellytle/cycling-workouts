
  <workout_file>
    <name> Day 2 Subthreshold XX1</name>
    <description>This is a challenging session that builds upon the earlier work of steady sub-threshold efforts.By challenging your ability to process lactate at near threshold power,  you will increase your time to exhaustion and increase endurance.All this is achieved with a 30min steady state effort that dips briefly into the realms of VO2.</description>
    <author>Zwift</author>
    <sportType>bike</sportType>
    <tags>
      <tag name="threshold"></tag>
<tag name="threshold"></tag>
    </tags>
    <workout>
      <SteadyState Duration="300" Power="0.5" />
<IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="0.65" OffPower="0.8"/>
<SteadyState Duration="180" Power="0.5" />
<IntervalsT Repeat="10" OnDuration="150" OffDuration="30" OnPower="0.92" OffPower="1.2"/>
<SteadyState Duration="300" Power="0.5" />
    </workout>
  </workout_file>
  