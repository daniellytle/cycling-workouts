
  <workout_file>
    <name>The Rollercoaster</name>
    <description>This Rollercoaster session aims to replicate the demands of a mountain bike ride / event. Mountain biking generally involves far more variations in effort compared with road riding - so plenty of surges and time spent being over geared!We touch upon all of these aspects in todays session, as we complete two blocks of alternating intensity, with top end Zone 6 surges thrown in there to replicate the demands of having to get up and over a steep bank or technical section. Feel free to get out of the saddle during the max efforts if you need to.We also have a 12 minute Sweet Spot effort in the middle, to help continue to develop our endurance.</description>
    <author>Zwift</author>
    <sportType>bike</sportType>
    <tags>
      
    </tags>
    <workout>
      <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75" />
<SteadyState Duration="60" Power="0.5" />
<SteadyState Duration="10" Power="1.09" />
<SteadyState Duration="120" Power="0.5" />
<IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1" OffPower="0.7"/>
<SteadyState Duration="30" Power="1.25" />
<SteadyState Duration="20" Power="0.5" />
<IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1" OffPower="0.7"/>
<SteadyState Duration="30" Power="1.25" />
<SteadyState Duration="180" Power="0.4" />
<SteadyState Duration="720" Power="0.88" />
<SteadyState Duration="180" Power="0.4" />
<IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1" OffPower="0.7"/>
<SteadyState Duration="30" Power="1.25" />
<SteadyState Duration="20" Power="0.5" />
<IntervalsT Repeat="5" OnDuration="30" OffDuration="30" OnPower="1" OffPower="0.7"/>
<SteadyState Duration="30" Power="1.25" />
<Cooldown Duration="410" PowerLow="0.55" PowerHigh="0.25" />
    </workout>
