<workout_file>
  <name>Van Vleuten VO2max</name>
  <description>Annemiek van Vleuten VO2max interval session: 3x3min at 110% FTP with 2min recovery, done twice, separated by 5min easy. Classic VO2max development work. Powers given directly as %FTP in the source.</description>
  <author>https://www.trainingpeaks.com/training-plans/cycling/tp-619690/train-like-the-pros-7-pro-cyclist-training-sessions</author>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="720" PowerLow="0.4" PowerHigh="0.8" />
    <SteadyState Duration="300" Power="0.5" />
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="1.1" OffPower="0.45"/>
    <SteadyState Duration="300" Power="0.5" />
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="120" OnPower="1.1" OffPower="0.45"/>
    <Cooldown Duration="300" PowerLow="0.5" PowerHigh="0.45" />
  </workout>
</workout_file>
