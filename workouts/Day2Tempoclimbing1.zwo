
  <workout_file>
    <name> Day 2 Tempoclimbing1</name>
    <description>The basis of today's session is to simulate long tempo climbs.However, each Tempo interval is completed with a different high intensity effort.The tempo portion of each interval is completed at a low climbing cadence.</description>
    <author>Zwift</author>
    <sportType>bike</sportType>
    <tags>
      <tag name="tempo"></tag>
<tag name="tempo"></tag>
<tag name="tempo"></tag>
    </tags>
    <workout>
      <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75" />
<SteadyState Duration="900" Cadence="75" Power="0.88" />
<SteadyState Duration="30" Power="1.5" />
<SteadyState Duration="300" Power="0.55" />
<SteadyState Duration="600" Cadence="75" Power="0.8" />
<SteadyState Duration="600" Power="0.98" />
<SteadyState Duration="300" Power="0.55" />
<SteadyState Duration="300" Cadence="75" Power="0.8" />
<SteadyState Duration="300" Power="1.05" />
<Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.5" />
    </workout>
  </workout_file>
  